# teach.py currently uses OpenRouter — this is the key it needs.
# Free keys: https://openrouter.ai/keys   (they start with sk-or-v1-)
OPENROUTER_API_KEY=your_key_here

# Previous providers, kept so teach.py can be switched back or compared.
# Gemini: free but only 20 requests per day per model.
GEMINI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
